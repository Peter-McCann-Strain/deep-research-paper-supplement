    "sonnet_new": "claude-sonnet-5",
    "sonnet_banked": "claude_sonnet (Sonnet 4.5)"
  },
  "methodology": {
    "verdict_methodology": "DRACO binary (SATISFIED / NOT_SATISFIED), judged blind from report text only",
    "sample_selection": "deterministic seed=42, stratified balanced round-robin over pattern x complexity",
    "population": "headline base_p0..base_p10 arms with BOTH banked Claude families present; report .md >= 5000 bytes",
    "n_reports": 40,
    "criteria_staged": "union of criteria scored by either banked Claude family per report (deduped by criterion_id)",
    "alignment": "NEW vs BANKED matched on identical (pattern, query_id, criterion_id); banked restricted to satisfied_is_known==True",
    "overall_recomputed": "each report overall = mean satisfied-rate over aligned criteria (NEVER trusts stored overall_score; banked claude_sonnet overall is known-corrupt upstream)",
