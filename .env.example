# Template: copy to `.env` and fill in your own credentials.
# `.env` is gitignored; this template is intentionally public.

# Public default: standard OpenAI API for generation/search/primary judging.
# These model IDs were release-tested on 2026-08-02. They are not a claim about
# provider-current best models or account entitlement.
# Override them for a paid rerun and record the exact IDs in your summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_JUDGE_MODEL=gpt-5.6-sol
OPENAI_WEB_SEARCH_TOOL=web_search

# Public Claude judge panel: Anthropic API only.
# These defaults were release-tested on 2026-08-02; check Anthropic before spending.
ANTHROPIC_API_KEY=
ANTHROPIC_OPUS_MODEL=claude-opus-4-8
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6

# Optional Azure OpenAI path. Use deployment names for generation/judging.
# The public generation workflow expects the OpenAI-compatible v1 Responses API
# and a deployment entitled for the configured hosted web_search tool.
USE_AZURE_OPENAI=false
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_JUDGE_DEPLOYMENT=

# Optional search/data helpers.
SEARCH_BACKEND=openai
SEMANTIC_SCHOLAR_API_KEY=

# Optional local paths. Relative paths resolve from the project root.
DR_DATA_DIR=data
DR_ARTIFACTS_DIR=artifacts
DR_PAPER_DIR=papers/paper_a_bounded_returns

# Optional budget guardrail estimates used by `deep-research cost` and `--max-cost-usd`.
# They are per-call planning values only; update them from current provider pricing.
DR_COST_OPENAI_GENERATION_USD_PER_CALL=0.20
DR_COST_OPENAI_WEB_SEARCH_USD_PER_CALL=0.01
DR_COST_OPENAI_JUDGE_USD_PER_CALL=0.05
DR_COST_ANTHROPIC_OPUS_JUDGE_USD_PER_CALL=0.30
DR_COST_ANTHROPIC_SONNET_JUDGE_USD_PER_CALL=0.10
